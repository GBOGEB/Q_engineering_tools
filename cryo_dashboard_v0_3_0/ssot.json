  "engineering_formulas": {
    "conduction_heat_load": {
      "formula": "Qdot = (A/L) × ∫[T_cold→T_warm] k(T)dT",
      "units": "W",
      "inputs": [
        "A (m²)",
        "L (m)",
        "T_cold (K)",
        "T_warm (K)"
      ]
    },
    "cooldown_energy": {
      "formula": "E = m × ∫[T1→T2] cp(T)dT",
      "units": "J",
      "inputs": [
        "m (kg)",
        "T1 (K)",
        "T2 (K)"
      ]
    },
    "thermal_strain": {
      "formula": "ΔL = L_ref × [Y(T2) − Y(T1)] × 1e-5",
      "units": "m",
      "inputs": [
        "L_ref (m)",
        "T1 (K)",
        "T2 (K)"
      ]
    },
    "series_thermal_resistance": {
      "formula": "R_total = Σᵢ (Lᵢ / (kᵢ_avg × Aᵢ))",
      "units": "K/W",
      "inputs": [
        "Per layer: L, k_avg, A"
      ]
    }
