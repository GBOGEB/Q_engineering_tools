        "description": "Specific heat capacity as a function of temperature"
      },
      "tc": {
        "name": "Thermal Contraction",
        "symbol": "Y(T)",
        "units": "×1e-5 [(L(T)−L293)/L293]",
        "description": "Fractional length change relative to 293 K"
      }
