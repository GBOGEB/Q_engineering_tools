{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/materials.schema.json",
  "title": "Cryogenic Dashboard Materials Database",
  "type": "object",
  "required": [
    "version",
    "materials"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "note": {
      "type": "string"
    },
    "temperature_validity_K": {
      "type": "object",
      "required": [
        "min",
        "max"
      ],
      "properties": {
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        }
      }
    },
    "materials": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "name",
          "source",
          "type",
          "units",
          "coefficients"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "type": {
            "enum": [
              "polylog",
              "copper"
            ]
          },
          "units": {
            "type": "string"
          },
          "coefficients": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "number"
            }
          }
        }
      }
    }
  }
}